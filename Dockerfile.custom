# Custom Scriberr build with FireRedASR2, Qwen3-ASR, and CAM++ adapters
# Based on Scriberr's Dockerfile.cuda

########################
# UI build stage
########################
FROM node:20-alpine AS ui-builder
WORKDIR /web

COPY web/frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY web/frontend ./frontend
RUN cd frontend && npm run build

########################
# Go build stage
########################
FROM golang:1.24-bookworm AS go-builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Copy built UI into embed path
RUN rm -rf internal/web/dist && mkdir -p internal/web
COPY --from=ui-builder /web/frontend/dist internal/web/dist

# Build binary
RUN CGO_ENABLED=0 go build -o /out/scriberr cmd/server/main.go

########################
# CUDA Runtime stage
########################
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 AS runtime

ENV PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8080 \
    DATABASE_PATH=/app/data/scriberr.db \
    UPLOAD_DIR=/app/data/uploads \
    WHISPERX_ENV=/app/whisperx-env \
    TRANSCRIPTS_DIR=/app/data/transcripts \
    APP_ENV=production \
    PUID=1000 \
    PGID=1000 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTORCH_CUDA_VERSION=cu126 \
    FIRERED_MODEL_DIR=/app/models/FireRedASR2-AED \
    FIRERED_SOURCE_DIR=/app/FireRedASR2S

WORKDIR /app

# System deps
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    curl ca-certificates ffmpeg git gosu unzip openssh-client \
    build-essential gcc g++ make python3-dev \
    python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && cp /root/.local/bin/uv /usr/local/bin/uv \
    && chmod 755 /usr/local/bin/uv \
    && uv --version

# Install yt-dlp
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

# FireRedASR2S source is required by firered adapter imports.
RUN git clone --depth 1 https://github.com/FireRedTeam/FireRedASR2S.git /app/FireRedASR2S \
    && rm -rf /app/FireRedASR2S/.git

# Create user
RUN groupadd -g 10001 appuser \
    && useradd -m -u 10001 -g 10001 appuser \
    && mkdir -p /app/data/uploads /app/data/transcripts /app/models \
    && chown -R appuser:appuser /app

# Copy binary and entrypoint
COPY --from=go-builder /out/scriberr /app/scriberr
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && chown appuser:appuser /app/scriberr

EXPOSE 8080
VOLUME ["/app/data", "/app/models"]

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/app/scriberr"]
